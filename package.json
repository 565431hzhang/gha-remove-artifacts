{
  "name": "gha-remove-artifacts",
  "version": "1.5.0",
  "description": "GitHub Action to remove old artifacts",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build index.js --minify",
    "dev": "cross-env NODE_ENV=dev node ./index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "github",
    "action",
    "remove",
    "artifact"
  ],
  "author": "c-hive",
  "license": "MIT",
  "//dependencies": {},
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "@octokit/plugin-throttling": "^11.0.5",
    "moment": "^2.30.1",
    "yn": "^5.1.0"
  },
  "//devDependencies": {
    "eslint*": "code style",
    "prettier": "code formatting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "0.45.0",
    "cross-env": "^10.1.0",
    "dotenv-safe": "^9.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": ">=1.1.18"
    }
  },
  "type": "module"
}
