{
  "name": "gha-remove-artifacts",
  "version": "1.5.0",
  "description": "GitHub Action to remove old artifacts",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build index.js --minify",
    "dev": "cross-env NODE_ENV=dev node ./index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "github",
    "action",
    "remove",
    "artifact"
  ],
  "author": "c-hive",
  "license": "MIT",
  "//dependencies": {
    "@actions/core": "read action inputs, report failure",
    "@octokit/action": "GitHub API client, authenticates with the workflow token",
    "@octokit/plugin-throttling": "respect rate limits, retry",
    "moment": "parse the `age` input, compare dates",
    "yn": "parse yes/no-like input values"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "@octokit/plugin-throttling": "^11.0.5",
    "moment": "^2.30.1",
    "yn": "^5.1.0"
  },
  "//devDependencies": {
    "@vercel/ncc": "bundle index.js and dependencies into dist/",
    "cross-env": "set NODE_ENV for the dev script",
    "dotenv-safe": "load .env in dev mode",
    "eslint*": "code style",
    "globals": "Node.js globals for ESLint",
    "prettier": "code formatting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "0.45.0",
    "cross-env": "^10.1.0",
    "dotenv-safe": "^9.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4",
  "type": "module"
}
